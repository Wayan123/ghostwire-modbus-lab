# Export these variables in the server environment; the application does not load .env files.
# Leave all three unset for deterministic fallback.
GHOSTWIRE_AI_BASE_URL=https://api.example.com/v1
GHOSTWIRE_AI_API_KEY=replace-with-your-key
GHOSTWIRE_AI_MODEL=replace-with-provider-model
# HTTP service listens only on 127.0.0.1. Default: 8000.
GHOSTWIRE_PORT=8000
